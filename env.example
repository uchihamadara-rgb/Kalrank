# Discord Bot Token (obrigatório)
DISCORD_TOKEN=seu_token_do_bot_aqui

# Client ID do bot (para registro de comandos slash)
DISCORD_CLIENT_ID=1093672834175356950

# Porta do servidor HTTP (para Render/health checks)
PORT=10000

# Configurações de XP
XP_PER_MINUTE=1
XP_BASE=100

# Persistência de dados (opcional - para PostgreSQL)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Log level: debug, info, warn, error
LOG_LEVEL=info
